# ═══════════════════════════════════════════════════════════════════
# TERMINUS BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ═══════════════════════════════════════════════════════════════════

# App Environment Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Terminus V2 Backend"
BACKEND_HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & Session Secrets (Minimum 32 characters in production)
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
SECRET_KEY=replace_with_secure_random_jwt_secret_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
WALLET_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Solana & Oracle Configuration
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
TERMINUS_PROGRAM_ID=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PROGRAM_ID=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
ORACLE_KEYPAIR_PATH=./terminus_oracle_keypair.json
ORACLE_KEYPAIR_SECRET=replace_with_base58_oracle_private_key

# Challenge Operational Rules
CHALLENGE_STAKE_LAMPORTS=5000000
CHALLENGE_TIMEOUT_SECONDS=2592000

# Docker Infrastructure & Database Routes
# Note: Inside Docker, hostnames must match compose services ('db' and 'redis')
DATABASE_URL=postgresql://postgres:postgres@db:5432/terminus
REDIS_URL=redis://redis:6379/0
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Third-Party API Integrations
OPENAI_API_KEY=sk-proj-replace_with_actual_openai_api_key
AT_USERNAME=sandbox
AT_API_KEY=atsk_replace_with_africas_talking_api_key
